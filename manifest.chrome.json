{
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/shared/theme.css", "styles.css"],
      "js": ["browser-polyfill.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
